      <div type="edition" xml:id="ed_Q_seq2" corresp="#Q">

            <p n="1" xml:id="Q_s2_p1">
            <seg xml:id="Q_s2_p1_a01" n="al_s2_p1_a01"><placeName ref="#asolo">Asolo</placeName> aduqnue, madonna ...,</seg>
            <app from="#Q_s2_p1_a01"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            vago et piacevole castello posto ne gli

            <seg xml:id="Q_s2_p1_a02" n="al_s2_p1_a02">estremi</seg>
            <app from="#Q_s2_p1_a02"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            gioghi delle nostre alpi sopra

            <seg xml:id="Q_s2_p1_a03" n="al_s2_p1_a03">'l</seg>
            <app from="#Q_s2_p1_a03"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            Trivigiano,

            <seg xml:id="Q_s2_p1_a04" n="al_s2_p1_a04">è hora (sì come dovete sapere) | </seg>
            <app from="#Q_s2_p1_a04"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            <seg xml:id="Q_s2_p1_a05" n="al_s2_p1_a05">arnese della <persName ref="#caterina">Reina di Cipri</persName>,</seg>
            <app from="#Q_s2_p1_a05"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            <seg xml:id="Q_s2_p1_a06" n="al_s2_p1_a06">la quale</seg>
            <app from="#Q_s2_p1_a06"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            <seg xml:id="Q_s2_p1_a07" n="al_s2_p1_a07">per la morte del <persName ref="#giacco">re Giacco</persName> suo marito, non guari con lui dimorata, rimasa vedova et sanza figliuoli, poi che così hebbe con somma soddisfattione de' suoi popoli quasi tutta la sua giovanezza trappassata, raccommandato il governo del regno alla Signoria nostra, in <placeName ref="#vinegia">Vinegia</placeName> se ne tornò, dove era nata, per rivedere e suoi parenti et appo loro nella sua patria più riposatamente menarne gli altri anni della sua vita.</seg>
            <app from="#Q_s2_p1_a07"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            <seg xml:id="Q_s2_p1_a08" n="al_s2_p1_a08"><gap reason="omitted"/></seg>
            <app from="#Q_s2_p1_a08"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            <seg xml:id="Q_s2_p1_a09" n="al_s2_p1_a09"><gap reason="omitted"/></seg>
            <app from="#Q_s2_p1_a09"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            <seg xml:id="Q_s2_p1_a10" n="al_s2_p1_a10"><gap reason="omitted"/></seg>
            <app from="#Q_s2_p1_a10"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            <seg xml:id="Q_s2_p1_a11" n="al_s2_p1_a11"><gap reason="omitted"/></seg>
            <app from="#Q_s2_p1_a11"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            <seg xml:id="Q_s2_p1_a12" n="al_s2_p1_a12">Dove venuta et lietamente ricevuta da' suoi, fu dalla Signoria nostra honorata di bellissimi et preciosi doni, tra' quali hebbe questo castello, del quale io dico, et per sito del luoco et per natura del paese et per salubrità d'aria amenissimo et piacevolissimo sopra modo.</seg>
            <app from="#Q_s2_p1_a12"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>
            </p>

            <p n="2" xml:id="Q_s2_p2">
            <seg xml:id="Q_s2_p2_a01" n="al_s2_p2_a01">Quivi essendo la Reina per diporto questo settembre passato</seg>
            <app from="#Q_s2_p2_a01"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            <seg xml:id="Q_s2_p2_a02" n="al_s2_p2_a02">(sì come suole spesso la state),</seg>
            <app from="#Q_s2_p2_a02"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            avvenne che ella

            <seg xml:id="Q_s2_p2_a03" n="al_s2_p2_a03">maritò</seg>
            <app from="#Q_s2_p2_a03"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            una delle sue damigielle, la quale, perciò che

            <seg xml:id="Q_s2_p2_a04" n="al_s2_p2_a04">bellissima giovane era</seg>
            <app from="#Q_s2_p2_a04"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            <seg xml:id="Q_s2_p2_a05" n="al_s2_p2_a05">et perchè da piccola fanciulla se l'havea allevata,</seg>
            <app from="#Q_s2_p2_a05"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            <seg xml:id="Q_s2_p2_a06" n="al_s2_p2_a06">ella più che alcuna dell'altre amava et havea cara.</seg>
            <app from="#Q_s2_p2_a06"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>
            </p>

            <p n="3" xml:id="Q_s2_p3">
            <seg xml:id="Q_s2_p3_a01" n="al_s2_p3_a01">Il perchè fece fare</seg>
            <app from="#Q_s2_p3_a01"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            l'apparecchio delle nozze

            <seg xml:id="Q_s2_p3_a02" n="al_s2_p3_a02">bellissimo,</seg>
            <app from="#Q_s2_p3_a02"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            et,

            <seg xml:id="Q_s2_p3_a03" n="al_s2_p3_a03">convitando de' luochi circonvicini chiunque</seg>
            <app from="#Q_s2_p3_a03"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            più honorato huomo

            <seg xml:id="Q_s2_p3_a04" n="al_s2_p3_a04">era con le lor donne,</seg>
            <app from="#Q_s2_p3_a04"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            et da <placeName ref="#vinegia">Vinegia</placeName>

            <seg xml:id="Q_s2_p3_a05" n="al_s2_p3_a05">altresì,</seg>
            <app from="#Q_s2_p3_a05"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            <seg xml:id="Q_s2_p3_a06" n="al_s2_p3_a06">in | suoni</seg>
            <app from="#Q_s2_p3_a06"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            et canti et balli et

            <seg xml:id="Q_s2_p3_a07" n="al_s2_p3_a07">sollennissimi conviti molti giorni</seg>
            <app from="#Q_s2_p3_a07"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            <seg xml:id="Q_s2_p3_a08" n="al_s2_p3_a08">ne menò</seg>
            <app from="#Q_s2_p3_a08"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>

            festeggiando con sommo

            <seg xml:id="Q_s2_p3_a09" n="al_s2_p3_a09">dilettamento et maraviglia d'ogniuno.</seg>
            <app from="#Q_s2_p3_a09"><rdg wit="#C"><supplied reason="placeholder">[apparato genetico C]</supplied></rdg></app>
            </p>
        </div>

