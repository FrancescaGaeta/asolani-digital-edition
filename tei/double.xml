            <seg xml:id="Q_s1_p1_a01" n="al_s1_p1_a01">Gli otij, madonna...,</seg>
            <app from="#Q_s1_p1_a01">
              <rdg wit="#C"><supplied reason="placeholder">[apparato C per questo segmento]</supplied></rdg>
            </app>

            <seg xml:id="Q_s1_p1_a02" n="al_s1_p1_a02">delle lettre sempre da me con somma vaghezza disiderati et cercati, et ne' miei primi anni assai di leggiero lunga stagione posseduti et sollecitati, et ultimatamente per le sopravenute mie cure interrotti et intralasciati, hora alla fine riconcedutimisi et ripresi, occasione mi porgono di ragionare in quella maniera che io posso con voi.</seg>
            <app from="#Q_s1_p1_a02">
